NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

PUBLIC_APP_URL=http://localhost:3000
PUBLIC_SHARE_BASE_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0

# The connected Vercel Blob store must be Public. Vercel supplies these two
# values for an OIDC-connected project; VERCEL_OIDC_TOKEN is injected at runtime.
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
# Optional legacy/local fallback when OIDC credentials are unavailable.
BLOB_READ_WRITE_TOKEN=
# Vercel Cron sends this as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
SHARE_RETENTION_DAYS=90

SHARE_UPLOAD_MAX_BYTES=8388608
SHARE_STORED_MAX_BYTES=8388608
SHARE_PROCESS_TIMEOUT_MS=5000
IMAGE_MAX_CONCURRENCY=2
IMAGE_QUEUE_LIMIT=8

RATE_LIMIT_SHARE_MAX=5
RATE_LIMIT_SHARE_WINDOW_MS=60000
SHUTDOWN_GRACE_MS=10000

# Deliberately disabled until real HEVC HEIC succeeds in the exact production build.
ENABLE_NORMALIZE_FALLBACK=false
